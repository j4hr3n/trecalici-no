{
  "name": "trecalici-no",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "worker/site.mjs",
  "build": {
    "command": "python3 scripts/build-seo.py"
  }
}
